# Copy to .env.local and fill in. NEVER commit .env.local. The repo is public.
# LiveKit (our own project; all three from the same project)
LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
AGENT_NAME=price-is-live-agent
# Chert
CHERT_API_KEY=
CHERT_PROJECT_ID=
CHERT_LINE_ID=
CHERT_FACETIME_BASE=https://facetime.trychert.com/api/v1
CHERT_APP_BASE=https://app.trychert.com/api/v1
LINE_DISPLAY_NUMBER=
CALL_MODE=outbound_group
# Players' phone numbers, comma-separated (+15551234567,+15557654321). The shared line hides who
# texted ("•••0101"), so the game matches the last digits to this list. Keep it in .env.local only.
PLAYER_PHONES=
# ElevenLabs (host voice and speech-to-text)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_TTS_FORMAT=pcm_24000
ELEVENLABS_CHAR_BUDGET=9000
STT_PROVIDER=elevenlabs
# Gemini (pricing, vision, host lines, embeddings)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
SEARCH_PROVIDER=gemini
# MongoDB Atlas
MONGODB_URI=
MONGODB_DB=priceislive
PHONE_HASH_SALT=
# Game
DEMO=0
STAGE_W=960
STAGE_H=540
STAGE_FPS=15
LOG_LEVEL=info
